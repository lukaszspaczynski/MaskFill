{
  "manifest_version": 3,
  "name": "Page Info",
  "version": "1.0",
  "description": "Shows structural information about the page you are viewing.",

  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/settings.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Page Info",
    "default_icon": {
      "16": "images/toolbar-16.png",
      "32": "images/toolbar-32.png"
    }
  },

  "options_ui": {
    "page": "options/options.html"
  },

  "permissions": ["storage"],

  "host_permissions": ["*://*/*"]
}
