{
  "manifest_version": 3,
  "name": "Mask Fill",
  "version": "1.0",
  "description": "Wypełnia wskazane znaki maskowanego hasła — z menedżera haseł lub z hasła zapisanego w pęku kluczy.",

  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://login.ingbank.pl/mojeing/app/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Mask Fill",
    "default_icon": {
      "16": "images/toolbar-16.png",
      "32": "images/toolbar-32.png"
    }
  },

  "options_ui": {
    "page": "options/options.html"
  },

  "permissions": ["storage", "scripting"],

  "host_permissions": ["https://login.ingbank.pl/mojeing/app/*"],

  "optional_host_permissions": ["*://*/*"]
}
